# Copy to .env. This service has its own database at platform/backend/compliance.db.
DATABASE_URL=sqlite:///backend/compliance.db
AUTO_CREATE_DB=true
APP_API_KEY=replace_with_same_random_key_as_SC_Control_Center_COMPLIANCE_API_KEY
AI_PROVIDER=offline
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=Qwen/Qwen3.8-27B
AI_TIMEOUT_SECONDS=300
AI_ASSESS_BATCH_SIZE=4
SC_ASSESS_BATCH_SIZE=2
AI_ASSESS_FAILURE_MODE=continue
CODEX_AGENT_ENABLED=false
CODEX_MODEL=gpt-6-luna
CODEX_TIMEOUT_SECONDS=180

# OpenAI API project key for Codex CLI server authentication.
CODEX_API_KEY=
